{
  "manifest_version": 3,
  "name": "RightKey to Obsidian Pro",
  "version": "2.1",
  "description": "一键将选中文本导入到 Obsidian 文档 - 专业版",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "send-selection": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "发送选中文本到 Obsidian（未选中文本时保存页面链接）"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
